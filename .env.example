# Required JSON strings, not file paths. Real secrets belong only in server environment.
FIREBASE_WEB_CONFIG_JSON={"apiKey":"PUBLIC_WEB_API_KEY","authDomain":"PROJECT_ID.firebaseapp.com","projectId":"PROJECT_ID","appId":"PUBLIC_APP_ID"}
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"PROJECT_ID","client_email":"SERVER_SERVICE_ACCOUNT_EMAIL","private_key":"-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_SERVER_SECRET\n-----END PRIVATE KEY-----\n"}
# Optional: must match both JSON project IDs.
# FIREBASE_PROJECT_ID=PROJECT_ID
GLOBAL_DAILY_CAP=100
# Leave unset until paid AI use is explicitly approved.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022
PORT=8080
HOST=127.0.0.1
